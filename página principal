<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>THE ROOKIE | Camino a la Leyenda</title>

    <link rel="stylesheet" href="style.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
</head>

<body>

    <!-- FONDO -->
    <div class="background"></div>

    <!-- NAVBAR -->
    <header class="navbar">

        <div class="logo">
            <span>THE</span>
            <strong>ROOKIE</strong>
        </div>

        <nav>
            <a href="#inicio">INICIO</a>
            <a href="#carrera">CARRERA</a>
            <a href="#ranking">RANKING</a>
            <a href="#como-jugar">CÓMO JUGAR</a>
        </nav>

        <div class="user">
            <div class="user-icon">🏀</div>
            <span>INVITADO</span>
        </div>

    </header>


    <!-- HERO -->
    <main id="inicio">

        <section class="hero">

            <div class="hero-content">

                <p class="small-title">TU HISTORIA. TU EQUIPO. TU LEGADO.</p>

                <h1>
                    CAMINO A LA
                    <span>LEYENDA</span>
                </h1>

                <p class="description">
                    Comenzá desde abajo, desarrollá tus habilidades,
                    llegá a la NBA y convertite en uno de los mejores
                    jugadores de la historia.
                </p>

                <div class="buttons">

                    <a href="#carrera" class="btn primary">
                        COMENZAR CARRERA
                    </a>

                    <a href="#como-jugar" class="btn secondary">
                        ¿CÓMO JUGAR?
                    </a>

                </div>

            </div>

            <div class="hero-ball">
                <div class="ball">🏀</div>
            </div>

        </section>


        <!-- CARRERA -->
        <section id="carrera" class="career">

            <div class="section-title">
                <p>EL CAMINO</p>
                <h2>CONSTRUÍ TU CARRERA</h2>
            </div>

            <div class="career-grid">

                <div class="career-card active">
                    <div class="number">01</div>

                    <div class="card-icon">🎓</div>

                    <h3>COLLEGE</h3>

                    <p>
                        Demostrá tu talento y convertite
                        en uno de los mejores prospectos.
                    </p>

                    <span class="status">DISPONIBLE</span>
                </div>


                <div class="career-card">
                    <div class="number">02</div>

                    <div class="card-icon">📋</div>

                    <h3>NBA DRAFT</h3>

                    <p>
                        Tus actuaciones determinarán
                        tu posición en el Draft.
                    </p>

                    <span class="status locked">BLOQUEADO</span>
                </div>


                <div class="career-card">
                    <div class="number">03</div>

                    <div class="card-icon">🏀</div>

                    <h3>NBA</h3>

                    <p>
                        Llegá a la liga y comenzá
                        tu verdadera carrera.
                    </p>

                    <span class="status locked">BLOQUEADO</span>
                </div>


                <div class="career-card">
                    <div class="number">04</div>

                    <div class="card-icon">🏆</div>

                    <h3>LEGADO</h3>

                    <p>
                        Ganá campeonatos, premios
                        y convertite en una leyenda.
                    </p>

                    <span class="status locked">BLOQUEADO</span>
                </div>

            </div>

        </section>


        <!-- CREAR JUGADOR -->
        <section class="player-section">

            <div class="player-image">
                <div class="silhouette">🏀</div>
            </div>

            <div class="player-info">

                <p class="small-title">TU CARRERA COMIENZA AHORA</p>

                <h2>CREÁ A TU<br><span>JUGADOR</span></h2>

                <p>
                    Elegí tu posición, definí tu estilo de juego
                    y comenzá a desarrollar las habilidades que
                    te llevarán hasta la NBA.
                </p>

                <div class="positions">

                    <div class="position">
                        <strong>PG</strong>
                        <span>BASE</span>
                    </div>

                    <div class="position">
                        <strong>SG</strong>
                        <span>ESCOLTA</span>
                    </div>

                    <div class="position">
                        <strong>SF</strong>
                        <span>ALERO</span>
                    </div>

                    <div class="position">
                        <strong>PF</strong>
                        <span>ALA-PÍVOT</span>
                    </div>

                    <div class="position">
                        <strong>C</strong>
                        <span>PÍVOT</span>
                    </div>

                </div>

                <button class="btn primary">
                    CREAR JUGADOR
                </button>

            </div>

        </section>


        <!-- ESTADISTICAS -->
        <section class="stats-section">

            <div class="section-title">
                <p>DESARROLLO</p>
                <h2>MEJORÁ TUS HABILIDADES</h2>
            </div>

            <div class="stats-container">

                <div class="stat">
                    <div class="stat-header">
                        <span>TIRO</span>
                        <strong>65</strong>
                    </div>
                    <div class="bar">
                        <div style="width:65%"></div>
                    </div>
                </div>


                <div class="stat">
                    <div class="stat-header">
                        <span>MANEJO</span>
                        <strong>60</strong>
                    </div>
                    <div class="bar">
                        <div style="width:60%"></div>
                    </div>
                </div>


                <div class="stat">
                    <div class="stat-header">
                        <span>PASE</span>
                        <strong>62</strong>
                    </div>
                    <div class="bar">
                        <div style="width:62%"></div>
                    </div>
                </div>


                <div class="stat">
                    <div class="stat-header">
                        <span>VELOCIDAD</span>
                        <strong>68</strong>
                    </div>
                    <div class="bar">
                        <div style="width:68%"></div>
                    </div>
                </div>


                <div class="stat">
                    <div class="stat-header">
                        <span>DEFENSA</span>
                        <strong>58</strong>
                    </div>
                    <div class="bar">
                        <div style="width:58%"></div>
                    </div>
                </div>


                <div class="stat">
                    <div class="stat-header">
                        <span>SALTO</span>
                        <strong>70</strong>
                    </div>
                    <div class="bar">
                        <div style="width:70%"></div>
                    </div>
                </div>

            </div>

        </section>


        <!-- RANKING -->
        <section id="ranking" class="ranking">

            <div class="section-title">
                <p>COMPETENCIA</p>
                <h2>RANKING DE JUGADORES</h2>
            </div>

            <div class="ranking-table">

                <div class="ranking-header">
                    <span>#</span>
                    <span>JUGADOR</span>
                    <span>POS</span>
                    <span>OVR</span>
                </div>

                <div class="ranking-row">
                    <span>01</span>
                    <strong>THE KING</strong>
                    <span>SF</span>
                    <b>94</b>
                </div>

                <div class="ranking-row">
                    <span>02</span>
                    <strong>THE SNIPER</strong>
                    <span>SG</span>
                    <b>92</b>
                </div>

                <div class="ranking-row">
                    <span>03</span>
                    <strong>THE TOWER</strong>
                    <span>C</span>
                    <b>90</b>
                </div>

                <div class="ranking-row">
                    <span>04</span>
                    <strong>ROOKIE_23</strong>
                    <span>PG</span>
                    <b>86</b>
                </div>

            </div>

        </section>


        <!-- COMO JUGAR -->
        <section id="como-jugar" class="how">

            <div class="section-title">
                <p>EMPEZÁ TU HISTORIA</p>
                <h2>¿CÓMO JUGAR?</h2>
            </div>

            <div class="steps">

                <div class="step">
                    <span>01</span>
                    <h3>CREÁ</h3>
                    <p>Diseñá tu jugador y elegí tu posición.</p>
                </div>

                <div class="step">
                    <span>02</span>
                    <h3>ENTRENÁ</h3>
                    <p>Mejorá tus estadísticas y habilidades.</p>
                </div>

                <div class="step">
                    <span>03</span>
                    <h3>COMPETÍ</h3>
                    <p>Jugá partidos y ganá experiencia.</p>
                </div>

                <div class="step">
                    <span>04</span>
                    <h3>TRIUNFÁ</h3>
                    <p>Conseguí títulos y construí tu legado.</p>
                </div>

            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer>

        <div class="logo">
            <span>THE</span>
            <strong>ROOKIE</strong>
        </div>

        <p>
            CAMINO A LA LEYENDA
        </p>

        <small>
            Proyecto inspirado en el mundo del básquet.
        </small>

    </footer>

</body>



* {
    margin: 0;
    padding: 0;
    box-sizing: border-box; 
    font-family: "Press Start 2P", system-ui, sans-serif;
    font-weight: 400;
    font-style: normal;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #08090d;
    color: white;
    font-family: "Inter", sans-serif;
}


/* =========================
   FONDO
========================= */

.background {
    position: fixed;
    inset: 0;

    background:
        linear-gradient(
            rgba(8, 9, 13, 0.88),
            rgba(8, 9, 13, 0.98)
        ),
        radial-gradient(
            circle at 80% 20%,
            rgba(255, 120, 20, 0.18),
            transparent 35%
        );

    z-index: -1;
}


/* =========================
   NAVBAR
========================= */

.navbar {
    width: 100%;
    height: 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;

    border-bottom: 1px solid rgba(255,255,255,0.08);

    background: rgba(8,9,13,0.85);
    backdrop-filter: blur(12px);

    position: sticky;
    top: 0;

    z-index: 100;
}


/* LOGO */

.logo {
    display: flex;
    flex-direction: column;

    line-height: 0.8;
}

.logo span {
    font-size: 11px;
    letter-spacing: 4px;
    font-weight: 700;
}

.logo strong {
    font-family: "Anton", sans-serif;
    font-size: 27px;
    letter-spacing: 1px;
}


/* NAV */

nav {
    display: flex;
    gap: 35px;
}

nav a {
    color: #aaa;
    text-decoration: none;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;

    transition: 0.3s;
}

nav a:hover {
    color: #ff7518;
}


/* USER */

.user {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 11px;
    font-weight: 700;
    color: #aaa;
}

.user-icon {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #333;
    border-radius: 50%;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 80px 10%;

    position: relative;

    overflow: hidden;
}


.hero-content {
    max-width: 650px;
    z-index: 2;
}

.small-title {
    color: #ff7518;

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 3px;

    margin-bottom: 20px;
}

.hero h1 {
    font-family: "Anton", sans-serif;

    font-size: clamp(65px, 9vw, 125px);

    line-height: 0.85;

    letter-spacing: -2px;
}

.hero h1 span {
    color: #ff7518;
    display: block;
}

.description {
    color: #aaa;

    max-width: 520px;

    line-height: 1.7;

    margin-top: 30px;
}


/* BUTTONS */

.buttons {
    display: flex;
    gap: 15px;

    margin-top: 35px;
}

.btn {
    border: none;

    padding: 17px 28px;

    font-family: "Inter", sans-serif;

    font-size: 12px;
    font-weight: 800;

    letter-spacing: 1px;

    cursor: pointer;

    text-decoration: none;

    display: inline-block;

    transition: 0.3s;
}

.primary {
    background: #ff7518;
    color: white;
}

.primary:hover {
    background: #ff8d42;
    transform: translateY(-3px);
}

.secondary {
    border: 1px solid #444;
    color: white;
}

.secondary:hover {
    border-color: #ff7518;
    color: #ff7518;
}


/* BALL */

.hero-ball {
    width: 420px;
    height: 420px;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;
}

.ball {
    font-size: 260px;

    filter:
        drop-shadow(0 30px 50px rgba(0,0,0,0.8));

    transform: rotate(-15deg);

    animation: float 4s ease-in-out infinite;
}

@keyframes float {

    0%,100% {
        transform: translateY(0) rotate(-15deg);
    }

    50% {
        transform: translateY(-20px) rotate(-10deg);
    }
}


/* =========================
   SECCIONES
========================= */

section {
    padding: 100px 10%;
}

.section-title {
    margin-bottom: 50px;
}

.section-title p {
    color: #ff7518;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 3px;

    margin-bottom: 8px;
}

.section-title h2 {
    font-family: "Anton", sans-serif;

    font-size: 48px;

    letter-spacing: 1px;
}


/* =========================
   CARRERA
========================= */

.career {
    background: #0d0f14;
}

.career-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;
}

.career-card {
    min-height: 300px;

    padding: 30px;

    background: #14161d;

    border: 1px solid #252832;

    position: relative;

    transition: 0.3s;
}

.career-card:hover {
    transform: translateY(-8px);
    border-color: #ff7518;
}

.career-card.active {
    border-color: #ff7518;
}

.number {
    color: #555;

    font-family: "Anton", sans-serif;

    font-size: 40px;
}

.card-icon {
    font-size: 35px;

    margin-top: 25px;
}

.career-card h3 {
    margin-top: 15px;

    font-family: "Anton", sans-serif;

    font-size: 25px;
}

.career-card p {
    color: #888;

    font-size: 13px;

    line-height: 1.6;

    margin-top: 10px;
}

.status {
    position: absolute;

    bottom: 25px;

    color: #ff7518;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2px;
}

.locked {
    color: #555;
}


/* =========================
   CREAR JUGADOR
========================= */

.player-section {
    display: flex;

    align-items: center;

    gap: 100px;

    min-height: 600px;
}

.player-image {
    width: 45%;
    height: 500px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #161920,
            #090a0d
        );

    border: 1px solid #272a33;

    overflow: hidden;
}

.silhouette {
    font-size: 220px;

    opacity: 0.7;

    filter: grayscale(1);
}

.player-info {
    max-width: 500px;
}

.player-info h2 {
    font-family: "Anton", sans-serif;

    font-size: 65px;

    line-height: 0.9;

    margin-bottom: 25px;
}

.player-info h2 span {
    color: #ff7518;
}

.player-info p {
    color: #888;

    line-height: 1.7;

    margin-bottom: 30px;
}


/* POSITIONS */

.positions {
    display: flex;

    gap: 8px;

    margin-bottom: 30px;
}

.position {
    width: 70px;
    height: 70px;

    border: 1px solid #30333c;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition: 0.3s;
}

.position strong {
    font-size: 20px;
}

.position span {
    font-size: 7px;

    color: #777;

    margin-top: 5px;
}

.position:hover {
    background: #ff7518;
    border-color: #ff7518;
}

.position:hover span {
    color: white;
}


/* =========================
   STATS
========================= */

.stats-section {
    background: #0d0f14;
}

.stats-container {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 30px 60px;

    max-width: 900px;
}

.stat-header {
    display: flex;

    justify-content: space-between;

    font-size: 12px;

    margin-bottom: 8px;
}

.stat-header strong {
    color: #ff7518;
}

.bar {
    height: 5px;

    background: #242630;
}

.bar div {
    height: 100%;

    background: #ff7518;
}


/* =========================
   RANKING
========================= */

.ranking {
    max-width: 1200px;

    margin: auto;
}

.ranking-table {
    border: 1px solid #272a33;
}

.ranking-header,
.ranking-row {
    display: grid;

    grid-template-columns:
        70px 1fr 100px 100px;

    align-items: center;

    padding: 20px 25px;
}

.ranking-header {
    background: #15171e;

    color: #666;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2px;
}

.ranking-row {
    border-top: 1px solid #22252d;

    color: #999;
}

.ranking-row strong {
    color: white;
}

.ranking-row b {
    color: #ff7518;

    font-size: 20px;
}


/* =========================
   COMO JUGAR
========================= */

.how {
    background: #0d0f14;
}

.steps {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}

.step {
    padding: 30px;

    border-left: 2px solid #333;

    transition: 0.3s;
}

.step:hover {
    border-color: #ff7518;
}

.step span {
    color: #ff7518;

    font-family: "Anton", sans-serif;

    font-size: 35px;
}

.step h3 {
    margin: 15px 0 10px;

    font-family: "Anton", sans-serif;

    font-size: 25px;
}

.step p {
    color: #777;

    font-size: 13px;

    line-height: 1.6;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 60px 10%;

    border-top: 1px solid #222;

    display: flex;

    align-items: center;

    justify-content: space-between;
}

footer p {
    color: #555;

    font-size: 11px;

    letter-spacing: 2px;
}

footer small {
    color: #444;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

    nav {
        display: none;
    }

    .hero {
        padding: 70px 7%;
    }

    .hero-ball {
        display: none;
    }

    .career-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .player-section {
        flex-direction: column;

        gap: 50px;
    }

    .player-image {
        width: 100%;
    }

    .steps {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 600px) {

    .career-grid,
    .stats-container,
    .steps {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 70px;
    }

    .player-info h2 {
        font-size: 50px;
    }

    .positions {
        flex-wrap: wrap;
    }

    .ranking-header,
    .ranking-row {
        grid-template-columns:
            40px 1fr 50px 50px;

        padding: 15px;
    }

    footer {
        flex-direction: column;

        gap: 20px;

        text-align: center;
    }

}
