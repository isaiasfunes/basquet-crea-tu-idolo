<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simón Dice - Colores</title>

</head>

<body>

    <style>
        * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #111;
    color: white;

    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
}

.game {
    width: 100%;
    max-width: 650px;
    text-align: center;
}

h1 {
    font-size: 42px;
    margin-bottom: 5px;
}

.subtitle {
    color: #aaa;
    margin-bottom: 25px;
}

.info {
    display: flex;
    justify-content: center;
    gap: 50px;
    margin-bottom: 20px;
}

.info div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.info span {
    color: #999;
    font-size: 14px;
}

.info strong {
    font-size: 22px;
}

/* MENSAJE */

#message {
    height: 30px;
    font-size: 18px;
    margin-bottom: 15px;
}

/* TABLERO */

.board {
    width: 100%;
    max-width: 560px;
    margin: auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

/* CUADROS */

.color-button {
    aspect-ratio: 1 / 1;

    border: none;
    border-radius: 12px;

    cursor: pointer;

    transition:
        transform 0.1s,
        filter 0.1s,
        box-shadow 0.1s;
}

.color-button:hover {
    transform: scale(1.03);
}

.color-button:active {
    transform: scale(0.95);
}

/* COLORES */

.red {
    background: #e63946;
}

.blue {
    background: #457b9d;
}

.green {
    background: #2a9d8f;
}

.yellow {
    background: #e9c46a;
}

.purple {
    background: #9b5de5;
}

.orange {
    background: #f4a261;
}

.pink {
    background: #e76f9a;
}

.cyan {
    background: #00b4d8;
}

/* EFECTO CUANDO SIMÓN MUESTRA LA SECUENCIA */

.color-button.active {
    filter: brightness(2);
    box-shadow: 0 0 30px white;
    transform: scale(0.95);
}

/* BOTÓN */

#start-button {
    margin-top: 25px;

    padding: 13px 35px;

    border: none;
    border-radius: 10px;

    background: #fff;
    color: #111;

    font-size: 18px;
    font-weight: bold;

    cursor: pointer;
}

#start-button:hover {
    background: #ddd;
}

#start-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* CELULAR */

@media (max-width: 500px) {

    h1 {
        font-size: 32px;
    }

    .info {
        gap: 25px;
    }

    .info strong {
        font-size: 18px;
    }

    .board {
        gap: 7px;
    }
}
    </style>

    <div class="game">

        <h1>🎨 SIMÓN DICE</h1>
        <p class="subtitle">Memorizá la secuencia y repetila</p>

        <div class="info">
            <div>
                <span>Ronda</span>
                <strong id="round">1/8</strong>
            </div>

            <div>
                <span>Secuencia</span>
                <strong id="sequence-length">1</strong>
            </div>

            <div>
                <span>Récord</span>
                <strong id="record">0</strong>
            </div>
        </div>

        <p id="message">Presioná "Comenzar"</p>

        <div id="board" class="board">
            <!-- Los 16 cuadros se generan con JavaScript -->
        </div>

        <button id="start-button">▶ Comenzar</button>

    </div>


    <script>
        const board = document.getElementById("board");

const message = document.getElementById("message");

const roundDisplay = document.getElementById("round");

const sequenceLengthDisplay =
    document.getElementById("sequence-length");

const recordDisplay =
    document.getElementById("record");

const startButton =
    document.getElementById("start-button");


// --------------------------------------------------
// CONFIGURACIÓN DEL JUEGO
// --------------------------------------------------

// 16 cuadros
const colors = [
    "red",
    "blue",
    "green",
    "yellow",

    "purple",
    "orange",
    "pink",
    "cyan",

    "red",
    "blue",
    "green",
    "yellow",

    "purple",
    "orange",
    "pink",
    "cyan"
];


// Las 8 rondas
// 1, 2, 3, 4, 5, 6, 6, 6
const rounds = [
    1,
    2,
    3,
    4,
    5,
    6,
    6,
    6
];


// --------------------------------------------------
// VARIABLES
// --------------------------------------------------

let buttons = [];

let sequence = [];

let playerSequence = [];

let currentRound = 0;

let playerTurn = false;

let record = 0;


// --------------------------------------------------
// CREAR LOS 16 CUADROS
// --------------------------------------------------

function createBoard() {

    board.innerHTML = "";

    buttons = [];

    colors.forEach((color, index) => {

        const button = document.createElement("button");

        button.classList.add(
            "color-button",
            color
        );

        button.dataset.index = index;

        button.addEventListener(
            "click",
            () => playerClick(index)
        );

        board.appendChild(button);

        buttons.push(button);
    });
}


// --------------------------------------------------
// COMENZAR JUEGO
// --------------------------------------------------

function startGame() {

    currentRound = 0;

    sequence = [];

    playerSequence = [];

    playerTurn = false;

    startButton.disabled = true;

    record = 0;

    recordDisplay.textContent = record;

    nextRound();
}


// --------------------------------------------------
// SIGUIENTE RONDA
// --------------------------------------------------

function nextRound() {

    playerTurn = false;

    playerSequence = [];

    // Pasar a la siguiente ronda
    currentRound++;

    // Si terminó las 8 rondas
    if (currentRound > rounds.length) {

        winGame();

        return;
    }


    // Cantidad de colores de esta ronda
    const sequenceLength =
        rounds[currentRound - 1];


    // Crear nueva secuencia
    sequence = [];


    for (let i = 0; i < sequenceLength; i++) {

        const randomIndex =
            Math.floor(Math.random() * buttons.length);

        sequence.push(randomIndex);
    }


    // Actualizar información
    roundDisplay.textContent =
        `${currentRound}/${rounds.length}`;

    sequenceLengthDisplay.textContent =
        sequenceLength;


    message.textContent =
        "👀 Mirá la secuencia...";


    // Mostrar secuencia
    setTimeout(() => {

        showSequence();

    }, 800);
}


// --------------------------------------------------
// MOSTRAR SECUENCIA
// --------------------------------------------------

async function showSequence() {

    playerTurn = false;

    for (let i = 0; i < sequence.length; i++) {

        const index = sequence[i];

        await sleep(500);

        buttons[index].classList.add("active");

        await sleep(450);

        buttons[index].classList.remove("active");
    }


    // Ahora juega el usuario
    playerTurn = true;

    message.textContent =
        "🎯 ¡Ahora repetí la secuencia!";
}


// --------------------------------------------------
// JUGADOR PRESIONA UN CUADRO
// --------------------------------------------------

function playerClick(index) {

    // No hacer nada si Simón está mostrando
    // la secuencia
    if (!playerTurn) {
        return;
    }


    // Mostrar brevemente el botón
    buttons[index].classList.add("active");

    setTimeout(() => {

        buttons[index].classList.remove("active");

    }, 150);


    // Guardar elección
    playerSequence.push(index);


    // Posición actual
    const position =
        playerSequence.length - 1;


    // Comprobar si es correcto
    if (
        playerSequence[position] !==
        sequence[position]
    ) {

        gameOver();

        return;
    }


    // ¿Terminó correctamente?
    if (
        playerSequence.length ===
        sequence.length
    ) {

        playerTurn = false;

        // Actualizar récord
        if (currentRound > record) {

            record = currentRound;

            recordDisplay.textContent = record;
        }


        message.textContent =
            "✅ ¡Correcto!";

        // Esperar antes de la siguiente ronda
        setTimeout(() => {

            nextRound();

        }, 1000);
    }
}


// --------------------------------------------------
// GAME OVER
// --------------------------------------------------

function gameOver() {

    playerTurn = false;

    message.textContent =
        `❌ ¡Te equivocaste! Llegaste a la ronda ${currentRound}.`;

    startButton.disabled = false;

    startButton.textContent =
        "🔄 Jugar de nuevo";
}


// --------------------------------------------------
// GANAR
// --------------------------------------------------

function winGame() {

    playerTurn = false;

    message.textContent =
        "🏆 ¡GANASTE! Completaste las 8 rondas.";

    startButton.disabled = false;

    startButton.textContent =
        "🔄 Jugar de nuevo";

    record = 8;

    recordDisplay.textContent = record;
}


// --------------------------------------------------
// FUNCIÓN PARA ESPERAR
// --------------------------------------------------

function sleep(milliseconds) {

    return new Promise(resolve => {

        setTimeout(resolve, milliseconds);

    });
}


// --------------------------------------------------
// BOTÓN COMENZAR
// --------------------------------------------------

startButton.addEventListener(
    "click",
    startGame
);


// --------------------------------------------------
// INICIAR TABLERO
// --------------------------------------------------

createBoard();
    </script>

</body>
</html>
