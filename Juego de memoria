<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Memoria de Básquet</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #111, #292929);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .game {
            width: 95%;
            max-width: 700px;
            text-align: center;
        }

        h1 {
            margin-bottom: 10px;
        }

        .info {
            display: flex;
            justify-content: space-around;
            font-size: 20px;
            margin: 15px 0;
        }

        #message {
            font-size: 18px;
            min-height: 25px;
        }

        .game-board {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin: 20px auto;
        }

        .card {
            height: 120px;
            perspective: 800px;
            cursor: pointer;
        }

        .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.4s;
            transform-style: preserve-3d;
        }

        .card.flipped .card-inner,
        .card.matched .card-inner {
            transform: rotateY(180deg);
        }

        .card-front,
        .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card-front {
            background: #e87500;
            font-size: 45px;
            border: 4px solid #ff9d32;
        }

        .card-back {
            background: white;
            color: black;
            font-size: 45px;
            transform: rotateY(180deg);
            border: 4px solid #ddd;
        }

        .matched .card-back {
            background: #75d675;
        }

        button {
            border: none;
            background: #e87500;
            color: white;
            font-size: 20px;
            font-weight: bold;
            padding: 14px 28px;
            border-radius: 10px;
            cursor: pointer;
            margin: 5px;
        }

        button:hover {
            background: #ff8c00;
        }

        /* Pantalla inicial */
        #start-screen {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.92);
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            z-index: 100;
            text-align: center;
        }

        #start-screen h1 {
            font-size: 50px;
            margin-bottom: 10px;
        }

        #start-screen p {
            font-size: 22px;
            margin-bottom: 25px;
        }

        #start-button {
            font-size: 25px;
            padding: 18px 35px;
        }

        @media (max-width: 500px) {
            .card {
                height: 85px;
            }

            .card-front,
            .card-back {
                font-size: 32px;
            }

            .info {
                font-size: 16px;
            }

            #start-screen h1 {
                font-size: 35px;
            }
        }
    </style>
</head>

<body>

<!-- Pantalla de inicio -->
<div id="start-screen">

    <h1>🏀 Memoria de Básquet 🏀</h1>

    <p>
        Encontrá las 8 parejas.<br>
        Tenés 5 vidas.
    </p>

    <button id="start-button">
        ▶️ Comenzar el juego
    </button>

</div>


<div class="game">

    <h1>🏀 Memoria de Básquet</h1>

    <div class="info">
        <div>❤️ Vidas: <span id="lives">5</span></div>
        <div>🎯 Parejas: <span id="pairs">0</span>/8</div>
    </div>

    <p id="message">
        Presioná "Comenzar el juego"
    </p>

    <div id="game-board" class="game-board"></div>

    <button id="restart">
        🔄 Reiniciar
    </button>

</div>


<script>

const board = document.getElementById("game-board");
const livesText = document.getElementById("lives");
const pairsText = document.getElementById("pairs");
const message = document.getElementById("message");

const restart = document.getElementById("restart");

const startScreen =
    document.getElementById("start-screen");

const startButton =
    document.getElementById("start-button");


// 8 parejas
const symbols = [
    "🏀", "🏀",
    "⛹️", "⛹️",
    "🏆", "🏆",
    "🥇", "🥇",
    "👟", "👟",
    "🎽", "🎽",
    "🔥", "🔥",
    "⭐", "⭐"
];


let firstCard = null;
let secondCard = null;

let lockBoard = true;

let lives = 5;
let pairs = 0;


// Mezclar
function shuffle(array) {

    for (let i = array.length - 1; i > 0; i--) {

        const j =
            Math.floor(Math.random() * (i + 1));

        [array[i], array[j]] =
        [array[j], array[i]];
    }

}


// Crear tablero
function createBoard() {

    board.innerHTML = "";

    firstCard = null;
    secondCard = null;

    lockBoard = true;

    lives = 5;
    pairs = 0;

    livesText.textContent = lives;
    pairsText.textContent = pairs;

    message.textContent =
        "👀 ¡Memorizá las cartas!";

    const cards = [...symbols];

    shuffle(cards);


    cards.forEach(symbol => {

        const card =
            document.createElement("div");

        card.classList.add("card");

        card.innerHTML = `
            <div class="card-inner">

                <div class="card-front">
                    🏀
                </div>

                <div class="card-back">
                    ${symbol}
                </div>

            </div>
        `;

        board.appendChild(card);

    });


    // Mostrar todas las cartas
    const allCards =
        document.querySelectorAll(".card");

    allCards.forEach(card => {
        card.classList.add("flipped");
    });


    // Después de 1 segundo se dan vuelta
    setTimeout(() => {

        allCards.forEach(card => {

            if (!card.classList.contains("matched")) {
                card.classList.remove("flipped");
            }

        });

        lockBoard = false;

        message.textContent =
            "🧠 ¡Encontrá todos los pares!";

    }, 1000);

}


// Dar vuelta una carta
function flipCard(card) {

    if (lockBoard) return;

    if (card === firstCard) return;

    if (card.classList.contains("matched")) return;

    card.classList.add("flipped");


    if (!firstCard) {

        firstCard = card;

        return;
    }


    secondCard = card;

    lockBoard = true;

    checkMatch();

}


// Comprobar pareja
function checkMatch() {

    const firstSymbol =
        firstCard
        .querySelector(".card-back")
        .textContent
        .trim();

    const secondSymbol =
        secondCard
        .querySelector(".card-back")
        .textContent
        .trim();


    if (firstSymbol === secondSymbol) {

        firstCard.classList.add("matched");
        secondCard.classList.add("matched");

        pairs++;

        pairsText.textContent = pairs;

        firstCard = null;
        secondCard = null;

        lockBoard = false;

        message.textContent =
            "✅ ¡Pareja encontrada!";


        // Ganó
        if (pairs === 8) {

            lockBoard = true;

            message.textContent =
                "🏆 ¡GANASTE! Encontraste todas las parejas.";

        }

    }

    else {

        lives--;

        livesText.textContent = lives;

        message.textContent =
            "❌ No coinciden.";

        setTimeout(() => {

            firstCard.classList.remove("flipped");
            secondCard.classList.remove("flipped");

            firstCard = null;
            secondCard = null;


            if (lives <= 0) {

                lockBoard = true;

                message.textContent =
                    "💥 GAME OVER. Te quedaste sin vidas.";

            }

            else {

                lockBoard = false;

            }

        }, 800);

    }

}


// Detectar clic
board.addEventListener("click", function(e) {

    const card =
        e.target.closest(".card");

    if (!card) return;

    flipCard(card);

});


// COMENZAR EL JUEGO
startButton.addEventListener("click", function() {

    startScreen.style.display = "none";

    createBoard();

});


// REINICIAR
restart.addEventListener("click", function() {

    createBoard();

});

</script>

</body>
</html>
